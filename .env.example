# ==========================================
#  MANIVTHA CRM — ENVIRONMENT CONFIGURATION
# ==========================================

# JWT Authorization Secret
JWT_SECRET=your_long_random_jwt_secret_here

# ------------------------------------------
# Telegram Bot Integration Keys
# ------------------------------------------
# 1. Search for @BotFather in Telegram and send /newbot to create your bot
# 2. Enter the bot token provided below:
TELEGRAM_BOT_TOKEN=

# 3. Direct Chat or Group Chat ID:
#    - For Group: Add bot to group, make admin, send message, and retrieve ID from:
#      https://api.telegram.org/bot<TOKEN>/getUpdates (negative number).
#    - For Direct Chat: Search for "@userinfobot" in Telegram, send a message,
#      and copy the resulting user ID (positive number, e.g. 987654321).
TELEGRAM_CHAT_ID=

# ------------------------------------------
# WhatsApp Twilio Integration Keys
# ------------------------------------------
# 1. Register for a free Twilio account at twilio.com
# 2. Set up the WhatsApp Sandbox inside Twilio Console
# 3. Copy/paste your Sandbox account credentials below:
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=

# 4. Twilio Sandbox sender (e.g., whatsapp:+14155238886)
WHATSAPP_FROM_NUMBER=

# 5. Your personal WhatsApp number to receive alerts (e.g., whatsapp:+919876543210)
WHATSAPP_TO_NUMBER=

# 6. Bot Username and Sandbox opt-in details
TELEGRAM_BOT_USERNAME=
WHATSAPP_SANDBOX_KEYWORD=
